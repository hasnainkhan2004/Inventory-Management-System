# Local development only; set a unique secret before deployment.
SECRET_KEY=django-insecure-local-development-only-change-before-deployment-000000000000
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional SMTP settings for password-reset email.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-your-smtp-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@example.com
